# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# node.js
#
node_modules/
npm-debug.log
yarn-error.log

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Release signing (never commit)
android/keystore.properties
*.jks
# The written-down copy of the keystore passwords. Belongs in a password
# manager, not a repo — this rule exists so a stray `git add .` can't leak it
# while it's sitting here waiting to be moved.
android/RELEASE_SIGNING_SECRETS.env
.env
.env.*
!.env.example

# Firebase — download from Firebase Console per app (never commit production secrets in public repos)
android/app/google-services.json
ios/GoogleService-Info.plist
ios/UstadApp/GoogleService-Info.plist

# App Store Connect API key (.p8) — CI writes this from a secret; never commit the real key
*.p8

# EAS local iOS signing credentials — CI writes these from secrets; never commit
credentials.json
*.p12
*.mobileprovision

# Metro / Gradle JS bundles (produced at build:apk / assembleRelease — do not commit)
*.jsbundle
*.bundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
